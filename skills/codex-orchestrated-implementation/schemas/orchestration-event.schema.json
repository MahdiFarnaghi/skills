{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable orchestration event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "type", "task_id", "milestone_id"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "type": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "milestone_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string"},
    "lease_id": {"type": "string"},
    "owner_role_instance_id": {"type": "string"},
    "host_thread_id": {"type": "string"},
    "expires_at": {"type": "string"},
    "generation": {"type": "integer", "minimum": 0}, "expected_lease_generation": {"type": "integer", "minimum": 0},
    "intent": {"type": "object"},
    "result": {"type": "object"},
    "wakeup": {"type": "object"},
    "receipt_digest": {"type": "string"},
    "allowed": {"type": "boolean"},
    "state": {"type": "object"}, "phase": {"type": "string"}, "job_id": {"type": "string"}, "host_job_id": {"type": "string"}, "invocation_id": {"type": "string"}, "receipt_id": {"type": "string"}, "wakeup_id": {"type": "string"}, "reference": {"type": "string"}, "outcome": {"type": "string"}, "finding_ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}, "check_id": {"type": "string"}, "complete": {"type": "boolean"}, "idempotency_key": {"type": "string"}, "milestone_index": {"type": "integer"}, "provider": {"type": "string"}
  }
}
