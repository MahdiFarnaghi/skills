{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qwen local assistant receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "invocation_id", "task_id", "milestone_id", "role", "role_instance_id", "session_id", "host_id", "context_id", "endpoint", "model", "capability_probe", "request_digest", "output_digest", "input_tokens", "output_tokens", "read_only", "untrusted", "write_mode", "outcome"],
  "properties": {
    "schema_version": {"const": 2},
    "receipt_type": {"const": "qwen_local_assistant"},
    "invocation_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "milestone_id": {"type": "string", "minLength": 1},
    "role": {"const": "qwen_local_assistant"},
    "role_instance_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "model": {"const": "Qwen3.8-27B"},
    "capability_probe": {"const": "confirmed"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "read_only": {"const": true},
    "untrusted": {"const": true},
    "write_mode": {"enum": ["disabled", "draft_patch"]},
    "outcome": {"type": "string", "minLength": 1},
    "failure": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
