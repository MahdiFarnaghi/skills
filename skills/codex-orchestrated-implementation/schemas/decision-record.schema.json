{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terra decision record",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["role_instance_id", "session_id", "host_id", "context_id", "provider", "model", "reasoning_effort", "host_identity", "resolution_source", "profile_digest"],
      "properties": {
        "role_instance_id": {"type": "string", "minLength": 1}, "session_id": {"type": "string", "minLength": 1}, "host_id": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "reasoning_effort": {"type": "string", "minLength": 1}, "host_identity": {"type": "string", "minLength": 1}, "resolution_source": {"type": "string", "minLength": 1}, "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["profiles", "worktree", "path_scope", "target_fingerprint", "policy_digest"],
      "properties": {
        "profiles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/profile"}, "minProperties": 4, "maxProperties": 4},
        "worktree": {"type": "string", "pattern": "^/"}, "path_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "target_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "required": ["schema_version", "record_type", "decision_id", "idempotency_key", "request_id", "task_id", "milestone_id", "milestone_index", "decided_by", "authority_role", "authority_available", "decision", "rationale", "binding", "status"],
  "properties": {
    "schema_version": {"const": 2}, "record_type": {"const": "decision"}, "decision_id": {"type": "string", "minLength": 1}, "idempotency_key": {"type": "string", "minLength": 1}, "request_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "milestone_id": {"type": "string", "minLength": 1}, "milestone_index": {"type": "integer", "minimum": 1}, "decided_by": {"const": "terra"}, "authority_role": {"const": "technical_authority"}, "authority_available": {"const": true}, "decision": {"enum": ["accept", "reject", "defer", "escalate"]}, "rationale": {"type": "string", "minLength": 1}, "binding": {"$ref": "#/$defs/binding"}, "status": {"const": "decided"}
  }
}
