{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestrated worker receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "milestone_id", "milestone_index", "round", "invocation_id",
    "invocation_kind", "pair_member", "provider", "model", "role",
    "worktree", "baseline", "path_scope", "target_fingerprint_before",
    "target_fingerprint_after", "read_only", "policy_digest", "resolved_orchestrator_profile",
    "outcome"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "task_id": {"type": "string", "minLength": 1},
    "milestone_id": {"type": "string", "minLength": 1},
    "milestone_index": {"type": "integer", "minimum": 1},
    "round": {"type": "integer", "minimum": 0},
    "invocation_id": {"type": "string", "minLength": 1},
    "invocation_kind": {"enum": ["implementation", "review"]},
    "pair_member": {"type": "string", "minLength": 1},
    "provider": {"enum": ["codex", "claude_code"]},
    "model": {"type": "string", "minLength": 1},
    "role": {"enum": ["implementer", "reviewer"]},
    "worktree": {"type": "string", "pattern": "^/"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["head_commit", "dirty_state_fingerprint"],
      "properties": {
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "dirty_state_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "path_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "target_fingerprint_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_fingerprint_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "read_only": {"type": "boolean"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_orchestrator_profile": {"$ref": "round-ledger.schema.json#/$defs/execution_profile"},
    "full_worktree_fingerprint_before": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "full_worktree_fingerprint_after": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role_instance_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "minLength": 1},
    "resolved_profile": {"$ref": "round-ledger.schema.json#/$defs/execution_profile"},
    "capability_preflight": {"type": "object", "additionalProperties": false, "properties": {
      "exact_snapshot_access": {"type": "boolean"}, "repository_inspection": {"type": "boolean"},
      "shell_execution": {"type": "boolean"}, "test_execution": {"type": "boolean"}, "crg_checks": {"type": "boolean"}
    }, "required": ["exact_snapshot_access", "repository_inspection", "shell_execution", "test_execution", "crg_checks"]},
    "checks_performed": {"type": "array", "items": {"type": "string"}},
    "checks_supplied_by_orchestrator": {"type": "array", "items": {"type": "string"}},
    "checks_unavailable": {"type": "array", "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "files_inspected": {"type": "array", "items": {"type": "string"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "outcome": {"enum": ["success", "failure", "transport_failure", "needs_correction", "approve", "escalate"]}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 2}}},
    "then": {"required": ["full_worktree_fingerprint_before", "full_worktree_fingerprint_after", "role_instance_id", "session_id", "host_id", "context_id", "resolved_profile"]}
  }]
}
